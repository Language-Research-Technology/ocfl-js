{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Treat anything tagged @lintignore as intentional.
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      // test/types: type-checked only, by test/tsconfig.json. package-smoke.js: run by check-package.sh.
      "entry": ["test/types/*.ts", "scripts/package-smoke.js"],
      // Loaded by semantic-release (from `preset`, and the npm plugin knip takes for its bundled copy), and publint, which check-package.sh runs.
      "ignoreDependencies": ["conventional-changelog-conventionalcommits", "@semantic-release/npm", "publint"],
      // A system tool the tests run to make a named pipe.
      "ignoreBinaries": ["mkfifo"]
    },
    "website": {
      // Type-checked only, by src/examples/tsconfig.json.
      "entry": ["src/examples/**/*.ts"]
    }
  }
}
