{
  "extends": "../../tsconfig.base.json",
  // rootDir spans the workspace so the specs can reach ../src and the shared @ocfl/ocfl-tests suite
  "compilerOptions": { "noEmit": true, "isolatedDeclarations": false, "rootDir": "${configDir}/../.." },
  "include": ["${configDir}/*.ts", "${configDir}/../../ocfl-tests/*.ts"]
}
