{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2024"
    ],
    "module": "nodenext",
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": false,
    "strict": false,
    "noImplicitAny": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "customConditions": [
      "@ocfl/source"
    ]
  },
  "include": [
    "src"
  ]
}
