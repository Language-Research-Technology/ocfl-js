{
  "name": "@ocfl/ocfl-fs",
  "version": "0.4.0",
  "description": "Oxford Common File Layout (OCFL) JS client library for filesystem storage",
  "keywords": [
    "ocfl",
    "Oxford Common File Layout",
    "preservation",
    "storage",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Language-Research-Technology/ocfl-js",
    "directory": "ocfl-fs"
  },
  "license": "GPL-3.0-or-later",
  "author": "Alvin Sebastian (https://orcid.org/0000-0002-9086-1722)",
  "contributors": [
    "Moises Sacal Bonequi (https://orcid.org/0000-0002-4438-2755)",
    "Peter Sefton (https://orcid.org/0000-0002-3545-944X)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "pretest": "pnpm --filter @ocfl/ocfl build",
    "test": "node --test 'test/**/*.spec.ts'",
    "build": "tsc",
    "pretypecheck": "pnpm --filter @ocfl/ocfl build",
    "typecheck": "tsc --noEmit && tsc -p test",
    "prepack": "tsc"
  },
  "devDependencies": {
    "@ocfl/ocfl": "workspace:^",
    "@ocfl/ocfl-tests": "workspace:*",
    "@types/node": "^22.20.5",
    "memfs": "^4.80.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@ocfl/ocfl": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
