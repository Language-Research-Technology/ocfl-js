{
  "name": "@ocfl/ocfl-fs",
  "version": "0.4.0",
  "description": "Oxford Common File Layout (OCFL) JS client library for filesystem storage",
  "keywords": [
    "ocfl",
    "Oxford Common File Layout",
    "preservation",
    "storage",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Language-Research-Technology/ocfl-js.git"
  },
  "license": "GPL-3.0-or-later",
  "author": "Alvin Sebastian (https://orcid.org/0000-0002-9086-1722)",
  "contributors": [
    "Moises Sacal Bonequi (https://orcid.org/0000-0002-4438-2755)",
    "Peter Sefton (https://orcid.org/0000-0002-3545-944X)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@ocfl/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "mocha",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc",
    "build-docs": "typedoc"
  },
  "dependencies": {
    "@ocfl/ocfl": "workspace:*"
  },
  "devDependencies": {
    "@ocfl/ocfl-tests": "workspace:*",
    "@types/node": "^22.20.5",
    "mocha": "^11.7.5",
    "typedoc": "^0.28.19",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "mocha": {
    "spec": [
      "test/**/*.spec.js"
    ],
    "node-option": [
      "conditions=@ocfl/source"
    ]
  }
}
