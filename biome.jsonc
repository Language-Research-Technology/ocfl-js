{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Written by pnpm
      "!pnpm-lock.yaml",
      // OCFL fixtures: vendored upstream fixtures plus inventories whose .sha512 sidecars depend on exact bytes
      "!!test/fixtures",
      // OCFL spec text, vendored verbatim
      "!!resources",
      // Generated from resources/ocfl_1.1.md
      "!!src/spec-text.ts",
      // Generated by api-extractor
      "!!docs/ocfl-fs.api.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 160 },
  "linter": {
    "enabled": true,
    "domains": { "project": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {},
      "style": { "useBlockStatements": "error", "useConsistentTypeDefinitions": "error" }
    }
  },
  "overrides": [
    // Tests index into fixtures whose keys they know exist
    { "includes": ["**/*.spec.ts"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }
  ],
  "javascript": { "formatter": { "quoteStyle": "single" } },
  // Parses Astro templates, so lint sees what they use from the frontmatter
  "html": { "experimentalFullSupportEnabled": true },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on", "useSortedProperties": "on" } }
  }
}
