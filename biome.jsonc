{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Written by pnpm
      "!pnpm-lock.yaml",
      // OCFL fixtures: the upstream fixtures submodule plus inventories whose .sha512 sidecars depend on exact bytes
      "!!ocfl-tests/test-data",
      // OCFL spec text, vendored verbatim
      "!!ocfl/resources"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "lineWidth": 160 },
  "linter": {
    "enabled": true,
    "domains": { "project": "recommended" },
    "rules": {
      "preset": "recommended",
      "nursery": {},
      "style": { "useBlockStatements": "error" }
    }
  },
  "overrides": [
    // Tests index into fixtures whose keys they know exist
    { "includes": ["**/*.spec.ts"], "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } } }
  ],
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on", "useSortedProperties": "on" } }
  }
}
