---
import StarlightSiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import { siteVersion } from '../../site-version.ts';

const version = siteVersion(process.env.SITE_VERSION);
---

<div class="site-title-with-version sl-flex">
  <StarlightSiteTitle />
  <span class="version"><span class="sr-only">Version </span><span translate="no">{version}</span></span>
</div>

<style>
  .site-title-with-version {
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
  }
  .version {
    flex-shrink: 0;
    padding: 0.125rem 0.375rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
</style>
