{
  "name": "@ocfl/ocfl-fs",
  "version": "0.4.0",
  "description": "Oxford Common File Layout (OCFL) JS client library for filesystem storage",
  "keywords": [
    "ocfl",
    "Oxford Common File Layout",
    "preservation",
    "storage",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Language-Research-Technology/ocfl-js"
  },
  "author": "Alvin Sebastian (https://orcid.org/0000-0002-9086-1722)",
  "contributors": [
    "Moises Sacal Bonequi (https://orcid.org/0000-0002-4438-2755)",
    "Peter Sefton (https://orcid.org/0000-0002-3545-944X)"
  ],
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "resources"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "tsc",
    "lint:knip": "knip",
    "lint:biome": "biome check .",
    "lint:consumer": "scripts/check-consumer.sh",
    "lint:api": "tsc && api-extractor run",
    "api:update": "tsc && api-extractor run --local",
    "format": "biome check --write .",
    "lint:types": "tsc --noEmit && tsc -p test",
    "test": "node --test 'test/**/*.spec.ts'",
    "coverage": "c8 pnpm test",
    "check:version-states": "node scripts/check-version-states.mts"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
