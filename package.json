{
  "name": "ocfl",
  "private": true,
  "description": "Oxford Common File Layout (OCFL) JS client library",
  "keywords": [
    "ocfl",
    "Oxford Common File Layout",
    "preservation",
    "storage",
    "filesystem"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Language-Research-Technology/ocfl-js"
  },
  "author": "Alvin Sebastian (https://orcid.org/0000-0002-9086-1722)",
  "contributors": [
    "Moises Sacal Bonequi (https://orcid.org/0000-0002-4438-2755)",
    "Peter Sefton (https://orcid.org/0000-0002-3545-944X)"
  ],
  "license": "GPL-3.0-or-later",
  "scripts": {
    "lint:knip": "knip",
    "lint:biome": "biome check .",
    "lint:consumer": "scripts/check-consumer.sh",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @ocfl/ocfl --filter @ocfl/ocfl-fs test",
    "coverage": "c8 pnpm test"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "c8": "^12.0.0",
    "knip": "^6.44.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
